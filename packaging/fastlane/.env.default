# Defaults fastlane loads before `.env`. Names and non-secret values only.
#
# Copy this to `.env` (git-excluded) and fill it in, or pass the same names as
# environment variables in CI. fastlane reads both files from this directory.
#
# --- what a Mac with Xcode already has ---------------------------------------
# A developer who is signed in to Xcode and holds an "Apple Development"
# certificate needs *nothing* but the team id: automatic signing mints and
# embeds the provisioning profile. Signing has to happen in the Aqua session —
# `codesign` fails with `errSecInternalComponent` from SSH — so run the lane
# from a Terminal on the desktop, not over a remote shell.
DEVELOPMENT_TEAM=YOUR_TEAM_ID

# --- the agent's identity ----------------------------------------------------
# This must be an App ID the team has *provisioned*: the Secure Enclave refuses
# to store a key for a bundle identifier the keychain cannot place, with
# `errSecMissingEntitlement`, which reads like a signing bug. Automatic signing
# registers a new App ID on first use when the account may create them.
TPMD_BUNDLE_ID=nexus.offworld.tpmd

# --- CI only -----------------------------------------------------------------
# An App Store Connect API key lets automatic signing run headless:
# `fastlane bundle_agent` uses it when all three are set.
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_KEY_CONTENT=base64-encoded .p8 contents

# --- occasional overrides ----------------------------------------------------
# CONFIGURATION=Release
# OUTPUT_DIRECTORY=packaging/build
