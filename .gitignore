# Local-only OpenCode skill directory: machine-specific test environments and
# secrets. Never commit (also listed in .git/info/exclude).
.opencode/

# Rust build artefacts.
/target
**/*.rs.bk

# Local runtime state produced when running the agent/demo by hand.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sock

# The macOS agent's signing configuration is deployment-owned: certificates,
# profiles and account identifiers never live in the repository.
packaging/fastlane/.env
packaging/fastlane/report.xml
packaging/build/
*.app
*.p8
*.mobileprovision

# Local secrets. The root .env holds publishing credentials (the Cloudsmith API
# key among them) and must never be committed — the file name is ignored at the
# root only, so the committed `packaging/fastlane/.env.default` template stays
# tracked.
/.env
/.env.*

# Debian packaging artefacts. `debian/` itself is committed; everything below is
# produced by a package build and must never be.
/dist/
/debian/cargo-home/
/debian/files
/debian/tpmd/
/debian/.debhelper/
/debian/changelog.orig
*.deb
*.buildinfo
*.changes

# A build run directly in the checkout leaves these behind — debhelper's own
# working files. The container build writes them into the tree, so ignore the
# patterns rather than trusting the next `git add -A`.
/debian/*.debhelper
/debian/*.substvars
/debian/*-build-stamp
# The split stages one directory per package beside the control files, so the
# pattern has to be here before the first split build rather than after it.
/debian/tpmd-*/

# The Cloudsmith CLI leaves its own logs in the working directory on a push, and
# they are root-owned when a containerised build pushed; never ours to commit.
.csm_*
