# Local-only OpenCode skill directory: machine-specific test environments and
# secrets. Never commit (also listed in .git/info/exclude).
.opencode/

# Rust build artefacts.
/target
**/*.rs.bk

# Local runtime state produced when running the agent/demo by hand.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sock

# The macOS agent's signing configuration is deployment-owned: certificates,
# profiles and account identifiers never live in the repository.
packaging/fastlane/.env
packaging/fastlane/report.xml
packaging/build/
*.app
*.p8
*.mobileprovision
